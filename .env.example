# Copy this file to ".env" and fill in ONE key. ".env" is git-ignored. Never paste a key into the code.

# gemini | anthropic | openai
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: model name (check your provider's current model list if you get HTTP 404)
# LLM_MODEL=gemini-2.5-flash

# Optional: for OpenAI-compatible services
# OPENAI_BASE_URL=https://api.openai.com/v1
